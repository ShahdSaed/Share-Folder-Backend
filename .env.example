PORT=3000

# Database Configuration
DATABASE_URL="mysql://root:password@localhost:3306/company_file_hub"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=""
DB_NAME=company_file_hub

NODE_ENV=development

# Authentication — JWT_SECRET must be at least 32 characters in production
JWT_SECRET="replace_with_a_secure_random_secret_at_least_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=refresh_token

# Cookie flags. Use SameSite=None and COOKIE_SECURE=true only with HTTPS cross-site Angular.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated frontend origins. Never use *.
# Example: CORS_ORIGINS=http://localhost:4200,https://share-folder-frontend.vercel.app
CORS_ORIGINS=

# File storage: "local" (disk) or "r2" (Cloudflare R2)
STORAGE_DRIVER=local
# Folder for uploaded files. On Render, mount a Persistent Disk at /var/data and set STORAGE_DIR=/var/data/private
# (without a disk, Render wipes files on every deploy/restart). Leave empty locally → backend/storage/private
STORAGE_DIR=
# Required when STORAGE_DRIVER=r2 (Cloudflare dashboard → R2 → Manage API tokens, "Object Read & Write")
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Reverse proxies in front of the API. Render only = 1; frontend proxies /api via Vercel rewrite → Render = 2
TRUST_PROXY=1
